# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit .env. Only this example file goes in Git.

# --- Database (your local PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fl_insurance
DB_USER=your_username
DB_PASSWORD=your_password_here

# --- Data source ---
# Only needed if the team uses an API. Leave blank if using downloaded files.
API_BASE_URL=
API_KEY=

# --- Project scope ---
STATE=FL
PLAN_YEAR=2026
